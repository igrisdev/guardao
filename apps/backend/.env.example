# Plantilla de variables de entorno del backend.
#
# Copiar a .env y ajustar. El archivo .env esta en .gitignore y NUNCA se sube.
# En local no hace falta: application-local.yml ya trae valores que coinciden
# con docker-compose.yml. Esta plantilla documenta lo que exigen staging y prod.

# Perfil activo: local | test | staging | prod
SPRING_PROFILES_ACTIVE=local

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/guardao
DB_USERNAME=guardao
DB_PASSWORD=guardao
DB_POOL_MAX=10

# Origenes permitidos por CORS (GUA-12). Lista exacta separada por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secreto de firma del JWT (GUA-11).
# Debe ser distinto en cada entorno. Generar uno con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- Las siguientes llegan en etapas posteriores, se listan para referencia ---

# Wompi (Etapa 5). Staging usa llaves de sandbox, produccion las reales.
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=

# Clave maestra para cifrar las credenciales de pasarela de cada negocio (ADR-005)
# ENCRYPTION_MASTER_KEY=

# WhatsApp Cloud API (Notificaciones)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
